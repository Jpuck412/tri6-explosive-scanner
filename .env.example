# Required for live scans. Either key name works.
POLYGON_API_KEY=
MASSIVE_API_KEY=

# Provider base URL. Keep Polygon default or point at a compatible endpoint.
MARKET_DATA_BASE_URL=https://api.polygon.io

# Universe controls only. These NEVER contribute to the TRI6 pattern score.
SCANNER_MIN_PRICE=0.10
SCANNER_MAX_PRICE=20
SCANNER_MIN_DAY_VOLUME=100000
SCANNER_MAX_UNIVERSE=120
SCANNER_CONCURRENCY=6

# API protection (recommended when deployed publicly)
SCANNER_ACCESS_TOKEN=
SCANNER_MAX_REQUESTS_PER_MINUTE=12

# Detection controls
SCANNER_LOOKBACK_BARS=160
SCANNER_PIVOT_WINDOW=2
SCANNER_MIN_PIVOTS_PER_SIDE=3
SCANNER_MIN_SCORE=68
SCANNER_LINE_TOUCH_TOLERANCE_PCT=0.45
SCANNER_HORIZONTAL_SLOPE_PCT_PER_BAR=0.035
SCANNER_MIN_SLOPE_PCT_PER_BAR=0.012
SCANNER_READY_DISTANCE_PCT=0.65
SCANNER_CONFIRM_BUFFER_PCT=0.12
